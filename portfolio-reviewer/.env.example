# Server Configuration
PORT=3000
NODE_ENV=development

# Session — REQUIRED in production (server refuses to start without it).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Admin login password — REQUIRED before going live on a public domain.
# If unset, a random password is generated on first run and printed to the
# server log once; set this and restart to use your own instead.
ADMIN_PASSWORD=

# Python FastAPI Backend (Portfolio AI Vision) — internal only, the browser
# never calls this directly. Keep it unreachable from outside this server.
PYTHON_API_URL=http://localhost:8099