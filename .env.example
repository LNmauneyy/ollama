# Ollama settings
OLLAMA_API_URL=http://localhost:11434/api/generate
VISION_MODEL_NAME=qwen2.5vl:7b
SYNTHESIS_MODEL_NAME=qwen2.5vl:7b

# PDF processing
# ปล่อยว่างไว้ถ้า poppler อยู่ใน PATH ของระบบแล้ว (macOS/Linux ที่ลงผ่าน brew/apt)
# บน Windows ให้ระบุ path เอง เช่น POPPLER_PATH=C:\poppler\bin
POPPLER_PATH=
MAX_FILE_SIZE_MB=30
MAX_PAGES=15

# Timeouts (seconds)
PAGE_READ_TIMEOUT=300
SYNTHESIS_TIMEOUT=600

# Concurrency
MAX_CONCURRENT_PAGES=3

# CORS
CORS_ORIGINS=["*"]

# Server
HOST=0.0.0.0
PORT=8099